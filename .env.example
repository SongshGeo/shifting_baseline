# Copy to `.env` and fill in your own paths. `.env` is gitignored and is loaded
# automatically on `import shifting_baseline` (see shifting_baseline/__init__.py).
# These back the `${oc.env:...}` interpolations in config/ds/*.yaml, so no
# machine-specific absolute path is ever committed.

# Repository root (this checkout). Cached intermediates live under ${SBS_ROOT}/data.
SBS_ROOT=/path/to/shifting_baseline

# Root folder holding the raw source datasets (tree-ring reconstructions, the
# historical drought/flood atlas, instrumental precipitation, base maps). These
# are not distributed with the repo — see docs/data for how to obtain them.
SBS_DATA_ROOT=/path/to/datasets

# Where figures / results.json are written (e.g. a manuscript output folder).
SBS_OUT_DIR=/path/to/outputs

# --- Optional: run-completion notifications (only used by abm.py / sensitivity.py
#     via the author's private `twist_academic` package; leave unset to disable) ---
# EMAIL_SENDER=you@example.com
# EMAIL_PASSWORD=your-app-password
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...
